OTEL_ADDR=localhost:4317
sidecar=true
plain=false
SAMPLE_RATE=0.01

queuing_export=false

num_of_users=50
num_of_posts=50
num_of_followers=15

NginxPort=2007
NginxEgress=localhost:4007

ComposePort=4005 
ComposeEgress=localhost:4005
# Note: Exec .env has ComposePort=2005 but ComposeEgress=localhost:4005. 
# K8s sidecars listen on 4005 for egress? 
# In local docker-compose, Sidecar listens on 4005 (Host) -> 4005 (Container).
# Wait, if App talks to Sidecar Egress, it uses Egress Port.
# And Sidecar Ingress listens on Ingress Port.
# Let's keep strict to exec .env.sidecar where possible but mapped to K8s:
# Sidecars in K8s (in same pod) listen on localhost.

HomePort=2002
HomeEgress=localhost:4002

UserPort=2001
UserEgress=localhost:4001

PostsAddr=localhost:2003
PostsPort=2003

GraphPort=2004
GraphEgress=localhost:4004

GeoMongoAddress=mongodb-geo:27017

REDIS_ADDR=social-redis:6379
