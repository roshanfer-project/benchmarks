deployment=fanin-lb
dagor=true
plain_lb=true
load_balancing_policy=round_robin

EntryGRPCPort=2000
ClientPort=2007
EntryGRPCAddr=fanin-lb-frontend-grpc:2000

backend1_ADDR=fanin-lb-backend1:2000
backend2_ADDR=fanin-lb-backend2:2000
frontend_ADDR=fanin-lb-frontend-grpc:2000
shared_ADDR=fanin-lb-shared:2000

PROM_ADDR=prometheus-pushgateway:9091