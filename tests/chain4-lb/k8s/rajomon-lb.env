deployment=chain4-lb
rajomon=true
plain_lb=true
load_balancing_policy=least_request

EntryGRPCPort=2000
ClientPort=2007
EntryGRPCAddr=chain4-lb-frontend-grpc:2000

backend1_ADDR=chain4-lb-backend1:2000
backend2_ADDR=chain4-lb-backend2:2000
backend3_ADDR=chain4-lb-backend3:2000
frontend_ADDR=chain4-lb-frontend-grpc:2000

PROM_ADDR=prometheus-pushgateway:9091