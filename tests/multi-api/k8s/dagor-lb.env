deployment=multi-api
dagor=true
plain_lb=true
load_balancing_policy=round_robin

EntryGRPCPort=2000
ClientPort=2007
EntryGRPCAddr=multi-api-frontend-grpc:2000

backend1_ADDR=multi-api-backend1:2000
backend2_ADDR=multi-api-backend2:2000
frontend_ADDR=multi-api-frontend-grpc:2000

PROM_ADDR=prometheus-pushgateway:9091