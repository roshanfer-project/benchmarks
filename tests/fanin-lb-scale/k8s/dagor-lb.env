deployment=fanin-lb-scale
dagor=true
plain_lb=true
load_balancing_policy=least_request

EntryGRPCPort=2000
ClientPort=2007
EntryGRPCAddr=fanin-lb-scale-frontend-grpc:2000

backend1_ADDR=fanin-lb-scale-backend1:2000
backend2_ADDR=fanin-lb-scale-backend2:2000
frontend_ADDR=fanin-lb-scale-frontend-grpc:2000
shared_ADDR=fanin-lb-scale-shared:2000

PROM_ADDR=prometheus-pushgateway:9091