# Kubernetes Config
K3S_VERSION="v1.31.4+k3s1"
CILIUM_VERSION="1.16.5"
CLUSTER_CIDR="10.42.0.0/16"
SERVICE_CIDR="10.43.0.0/16"

# Kubelet Resources
# 100m = 0.1 CPU core, 100Mi = 100 Megabytes
KUBE_RESERVED="cpu=100m,memory=100Mi"
SYSTEM_RESERVED="cpu=100m,memory=100Mi"
EVICTION_HARD="memory.available<500Mi,nodefs.available<1Gi"

# CPU Manager
CPU_MANAGER_POLICY="static"

# SSH
SSH_OPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null"
