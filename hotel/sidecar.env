deployment=hotel
sidecar=true

# Service Ports (Container ports)
FrontendPort=2007
ProfilePort=2001
SearchPort=2005
GeoPort=2004
RatePort=2003
ReservationPort=2002
UserPort=2006

# Egress Addresses (Localhost + Egress Port)
# Frontend calls:
FrontendEgress=localhost:4007
# Search calls:
SearchEgress=localhost:4005

# Other configs
consulAddr=consul:8500
jaegerAddress=jaeger:14268
