deployment=hotel
dagor=true

# Service Ports
FrontendPort=2007
FrontendGRPCPort=2009
ProfilePort=2001
SearchPort=2005
GeoPort=2004
RatePort=2003
ReservationPort=2002
UserPort=2006

# Service Addresses (K8s Service DNS)
ProfileAddr=hotel-profile:2001
SearchAddr=hotel-search:2005
GeoAddr=hotel-geo:2004
RateAddr=hotel-rate:2003
ReservationAddr=hotel-reservation:2002
UserAddr=hotel-user:2006

# DB and Cache Addresses
GeoMongoAddress=mongodb-geo:27017
ProfileMongoAddress=mongodb-profile:27017
ProfileMemcAddress=memcached-profile:11211
RateMongoAddress=mongodb-rate:27017
RateMemcAddress=memcached-rate:11211
ReserveMongoAddress=mongodb-reservation:27017
ReserveMemcAddress=memcached-reserve:11211
UserMongoAddress=mongodb-user:27017

# Other configs
consulAddr=consul:8500
jaegerAddress=jaeger:14268

# Client Config
ClientPort=2007
FrontendGRPCAddr=frontend-grpc:2009

# Prometheus
PROM_ADDR=prometheus-pushgateway:9091
